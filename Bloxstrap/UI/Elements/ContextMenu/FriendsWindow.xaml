<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.ContextMenu.FriendsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        xmlns:resources="clr-namespace:Bloxstrap.Resources"
        Title="{x:Static resources:Strings.Friends_Window_Title}"
        Width="360"
        Height="420"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" Title="{x:Static resources:Strings.Friends_Window_Title}" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

        <StackPanel Grid.Row="1" Margin="12,0,12,12">
            <ui:ProgressRing x:Name="LoadingRing" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,20,0,0" />
            <TextBlock x:Name="ErrorText" Text="" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
            <ListView x:Name="FriendsList" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</base:WpfUiWindow>
